#!/usr/bin/env bash
set -euo pipefail

case "$1 $2" in
  'release view') exit 1 ;;
  'api repos/{owner}/{repo}/git/ref/tags/'*) printf 'tag-sha\n' ;;
  'api --method') exit 0 ;;
  'release create')
    release="$3"
    destination="$GH_CAPTURE/$release"
    mkdir -p "$destination"
    shift 3
    printf '%s\n' "$@" > "$destination/arguments"
    skip_value=false
    for argument in "$@"; do
      if [[ "$skip_value" == true ]]; then
        skip_value=false
        continue
      fi
      case "$argument" in
        --target|--title|--notes-file)
          skip_value=true
          continue
          ;;
        --*) continue ;;
      esac
      cp "$argument" "$destination/"
    done
    ;;
  *) printf 'Unexpected gh command: %s\n' "$*" >&2; exit 1 ;;
esac
